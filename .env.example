# ==============================================================================
# VaxGuard Enterprise Configuration
# ==============================================================================

# Target LLM Engine Model Name (Supported on Groq: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b)
DEFAULT_MODEL=qwen/qwen3.8-27b

# Groq API Keys (Supports up to 5 keys for automatic Round-Robin rate-limit rotation)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_API_KEY_5=your_groq_api_key_5_here

# Alternatively, single key fallback:
# GROQ_API_KEY=your_single_groq_key_here

# Database URL (Defaults to local async SQLite, or configure PostgreSQL: postgresql+asyncpg://user:pass@host:5432/vaxguard)
DATABASE_URL=sqlite+aiosqlite:///data/vaxguard.db

# API Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
